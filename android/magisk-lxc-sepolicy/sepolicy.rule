# LXC SELinux Policy for Bridge Networking
# This policy is applied at boot by Magisk
# TEAM_004: Targeted permissive - ONLY lxc_t, not shell/magisk

# Define lxc types if not already defined
type lxc_t
type lxc_exec_t
type lxc_data_file
type lxc_config_file

# TARGETED PERMISSIVE: Only lxc_t domain is permissive
# Shell and magisk remain in enforcing mode for security
permissive lxc_t

# Shell permissions for direct bridge operations
allow shell shell netlink_route_socket { create bind read write nlmsg_read nlmsg_write getattr setattr }
allow shell shell netlink_tcpdiag_socket { create bind read write nlmsg_read getattr }
allow shell shell capability { net_admin net_raw }
allow shell shell file { execute read write getattr }
allow shell shell process { setexec transition }
allow shell shell unix_stream_socket { create connect read write }
allow shell shell udp_socket { create bind read write getattr connect }
allow shell shell tcp_socket { create bind read write getattr connect }
allow shell shell rawip_socket { create bind read write getattr }

# Shell to lxc_t transition support
allow shell lxc_t process { transition signal sigkill sigstop }

# LXC domain network permissions
allow lxc_t self netlink_route_socket { create bind read write nlmsg_read nlmsg_write getattr setattr }
allow lxc_t self netlink_tcpdiag_socket { create bind read write nlmsg_read getattr }
allow lxc_t self netlink_kobject_uevent_socket { create bind read getattr }
allow lxc_t self capability { net_admin net_raw sys_admin chown dac_override dac_read_search fowner fsetid setgid setuid sys_chroot sys_ptrace kill sys_resource mknod sys_nice ipc_lock }
allow lxc_t self capability2 { syslog block_suspend }

# Socket operations for container networking
allow lxc_t self udp_socket { create bind read write getattr connect setopt }
allow lxc_t self tcp_socket { create bind read write getattr connect listen accept setopt }
allow lxc_t self packet_socket { create bind read write getattr setopt }
allow lxc_t self unix_stream_socket { create bind read write getattr listen accept connect setopt }
allow lxc_t self unix_dgram_socket { create bind read write getattr connect sendto }
allow lxc_t self rawip_socket { create bind read write getattr setopt }

# TUN/TAP device management
allow lxc_t self tun_socket { create read write relabelfrom relabelto attach_queue }
allow lxc_t tun_device chr_file { read write open getattr ioctl }

# Process management
allow lxc_t self process { fork setexec setpgid setsched signal_perms setcap setrlimit ptrace getsched execmem }

# File operations for memfd (lxc-attach fix)
allow lxc_t self file { execute read write getattr }

# Filesystem permissions
allow lxc_t lxc_data_file dir { create read write open getattr setattr search add_name remove_name rmdir }
allow lxc_t lxc_data_file file { create read write open getattr setattr unlink rename execute execute_no_trans map }
allow lxc_t lxc_data_file lnk_file { create read getattr unlink setattr }
allow lxc_t lxc_data_file sock_file { create read write getattr unlink }
allow lxc_t lxc_data_file fifo_file { create read write getattr unlink }
allow lxc_t lxc_data_file blk_file { create read write getattr unlink }
allow lxc_t lxc_data_file chr_file { create read write getattr unlink setattr }
allow lxc_t lxc_data_file filesystem { mount unmount remount getattr }

# Config file access
allow lxc_t lxc_config_file file { read open getattr }
allow lxc_t lxc_config_file dir { read open getattr search }

# Shell data file access
allow lxc_t shell_data_file dir { read write open getattr setattr search add_name remove_name }
allow lxc_t shell_data_file file { read write open getattr setattr create unlink }

# Proc access
allow lxc_t proc dir { read open getattr search }
allow lxc_t proc file { read write open getattr }
allow lxc_t proc lnk_file read
allow lxc_t proc_net dir { read open getattr search }
allow lxc_t proc_net file { read open getattr }

# Sysfs access
allow lxc_t sysfs dir { read open getattr search }
allow lxc_t sysfs file { read open getattr }
allow lxc_t sysfs lnk_file read

# Cgroup access
allow lxc_t cgroup dir { create read write open getattr setattr search add_name remove_name }
allow lxc_t cgroup file { read write open getattr setattr }
allow lxc_t cgroup_v2 dir { create read write open getattr setattr search add_name remove_name }
allow lxc_t cgroup_v2 file { read write open getattr setattr }

# Tmpfs access
allow lxc_t tmpfs dir { create read write open getattr setattr search add_name remove_name rmdir }
allow lxc_t tmpfs file { create read write open getattr setattr unlink }
allow lxc_t tmpfs lnk_file { create read getattr unlink }
allow lxc_t tmpfs sock_file { create read write getattr unlink }
allow lxc_t tmpfs chr_file { read write getattr }
allow lxc_t tmpfs blk_file { read write getattr }
allow lxc_t tmpfs filesystem { mount unmount remount }

# Device access
allow lxc_t devpts dir { read write open getattr setattr search add_name remove_name }
allow lxc_t devpts chr_file { read write open getattr setattr ioctl }
allow lxc_t ptmx_device chr_file { read write open getattr ioctl }
allow lxc_t console_device chr_file { read write open getattr ioctl }
allow lxc_t tty_device chr_file { read write open getattr ioctl }
allow lxc_t device dir { read open getattr search }
allow lxc_t null_device chr_file { read write open getattr }
allow lxc_t zero_device chr_file { read write open getattr }
allow lxc_t random_device chr_file { read open getattr }
allow lxc_t urandom_device chr_file { read open getattr }
allow lxc_t fuse_device chr_file { read write open getattr ioctl }

# Namespace operations
allow lxc_t self user_namespace create

# Mount/filesystem operations
allow lxc_t labeledfs filesystem { mount unmount remount getattr }
allow lxc_t proc filesystem { mount unmount remount getattr }
allow lxc_t sysfs filesystem { mount unmount remount getattr }
allow lxc_t devpts filesystem { mount unmount remount getattr }
allow lxc_t cgroup filesystem { mount unmount remount getattr }
allow lxc_t cgroup_v2 filesystem { mount unmount remount getattr }

# IPC with shell
allow lxc_t shell fd use
allow lxc_t shell fifo_file { read write getattr ioctl }
allow lxc_t shell unix_stream_socket { read write getattr }

# Executable access
allow lxc_t lxc_exec_t file { read open getattr execute execute_no_trans map }

# Keyring access
allow lxc_t self key { search write read view link }

# Additional netlink sockets
allow lxc_t self netlink_xfrm_socket { create bind read write nlmsg_read }
allow lxc_t self netlink_netfilter_socket { create bind read write }
allow lxc_t self netlink_audit_socket { create bind read write nlmsg_read nlmsg_write }
